# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://asyncflow:asyncflow123@localhost:5432/asyncflow?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue
QUEUE_NAME=asyncflow-jobs
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true

# Worker
WORKER_ID=worker-1
WORKER_HEARTBEAT_INTERVAL=30000
WORKER_GRACEFUL_SHUTDOWN_TIMEOUT=30000

# Retry Strategy
RETRY_STRATEGY=exponential
RETRY_BASE_DELAY=1000
RETRY_MAX_DELAY=60000
RETRY_MULTIPLIER=2
